# props_demo — banco degli assi §6 (ENTITY_DESIGN + §8.5): prop solidi dal
# catalogo applicati da prop_world_apply in build_world.
# Layout: spawn a ovest, goal a est. Sulla strada: un BUS di traverso (yaw 60,
# indistruttibile, tier palazzo -> l'orda lo aggira), una linea di CANCELLATE
# (fence, assediabili hp 350 tier 0.6 -> l'orda le preme e le sfonda; opacita'
# 0.3: le torrette sparano attraverso a danno ridotto) e un BUILDING (10x8,
# indistruttibile) che fa da spigolo urbano. Decor sparso per il confronto.
cell 0.5
world 100 70
set k_density 2.5
set k_jam 8

goal 92 30 4 10

# torrette dietro la linea di cancellate: LoS attraverso la fence (asse C)
turret 62 28 40
turret 62 42 40

# bus di traverso sulla diagonale nord
prop bus 40 46 60
# building: blocco urbano a sud del varco
prop building 40 14 0
# linea di cancellate a meta' mappa (tre segmenti da 2 m, varco fra i gruppi)
prop fence 55 26 90
prop fence 55 28 90
prop fence 55 32 90
prop fence 55 34 90
prop fence 55 42 90
prop fence 55 44 90
# decor inerte / distruttibile per confronto
prop bench 30 35 20
prop crate 33 30 0
prop table 45 33 0
prop traflight 50 24 0

spawn 2 20 4 30
