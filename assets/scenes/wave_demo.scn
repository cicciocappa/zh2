# wave_demo — banco delle ondate scriptate (LOOP_DESIGN A). Stessa pianta di
# mission_demo, ma l'assalto e' una SEQUENZA ANNUNCIATA: 4 ondate a
# escalation (walker -> +tank -> due direzioni -> finale con obesi), ognuna
# preceduta dalla pausa `wave.pause` di balance.cfg (default 15 s) col banner
# "ONDATA k/N ... DA <direzione>". INVIO in assalto = "chiama la prossima"
# (+biomassa proporzionale ai secondi risparmiati, `wave.bonus`).
# PREP illimitata (INVIO = via). CLEAR: si vince a ondate finite e mappa
# pulita. Con le righe `wave` il rate/pool delle exit e' ignorato.
cell 0.5
world 100 70
set k_density 2.5
set k_jam 8

mission clear 0 budget 600
lz 78 35

# exit: coi wave sono solo rect di spawn + marker (rate/delay/pool ignorati)
exit 2 12 3 14 0 0 0
exit 2 44 3 14 0 0 0
exit 46 2 14 3 0 0 0

# ondate: n exit_idx count rate [tank pct] [obese pct]
wave 1 0 60 8
wave 2 1 80 10 tank 5
wave 3 0 60 8 tank 8
wave 3 2 40 6
wave 4 0 120 10 tank 12 obese 25
wave 4 1 80 10 tank 12

# difese di partenza davanti alla LZ
turret 70 28 35
turret 70 42 35
wall 500 1.0 66 26 1.5 18

# arredo urbano
prop building 50 18 0
prop bus 55 52 40
prop fence 60 32 90
prop fence 60 34 90
prop fence 60 38 90
prop fence 60 40 90
prop bench 40 35 20
prop traflight 45 25 0
