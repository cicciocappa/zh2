# mission_demo — banco della fase A (mission.c): PREP a tempo (10 s, INVIO
# per partire subito), poi ASSALTO da tre exit scriptate (rate flat, la terza
# parte in ritardo). LZ a est = core assediabile (anello 5x5, HP 1500 o
# VAT_HORDE_LZ_HP) + goal centrale: l'orda converge li'. SURVIVE 120 s.
# Budget 600 per il piazzamento (P) — solo in PREP.
cell 0.5
world 100 70
set k_density 2.5
set k_jam 8

mission survive 120 prep 10 budget 600
lz 78 35

# exit scriptate: x y w h rate [delay] [pool 0=inf]
exit 2 12 3 14 8 0 0
exit 2 44 3 14 8 5 0
exit 46 2 14 3 6 25 0

# difese di partenza davanti alla LZ
turret 70 28 35
turret 70 42 35
wall 500 1.0 66 26 1.5 18

# arredo urbano (assi §6: bus/building solidi, fence assediabili, decor)
prop building 50 18 0
prop bus 55 52 40
prop fence 60 32 90
prop fence 60 34 90
prop fence 60 38 90
prop fence 60 40 90
prop bench 40 35 20
prop traflight 45 25 0
